{
  "name": "edunex-server",
  "version": "1.0.0",
  "description": "edunex Backend API Server - Node.js Express TypeScript Prisma",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
